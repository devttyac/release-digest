# Copy to .env and fill in. .env is gitignored — never commit real values.
#   chmod 600 .env

# https://www.themoviedb.org/settings/api  (v3 API key)
TMDB_API_KEY=your_tmdb_key_here

# https://rawg.io/apidocs
RAWG_API_KEY=your_rawg_key_here

# The sending Gmail account.
GMAIL_ADDRESS=you@gmail.com

# A Google App Password, NOT your account password:
#   Google Account > Security > 2-Step Verification > App passwords
# Google shows it as "abcd efgh ijkl mnop"; spaces are stripped automatically.
GMAIL_APP_PASSWORD=your_app_password_here

# Where the digest is sent. Can be the same address as GMAIL_ADDRESS.
# Accepts a comma-separated list for multiple recipients:
#   DIGEST_RECIPIENT=you@example.com,someone@example.net
DIGEST_RECIPIENT=you@example.com

# Optional: Uptime Kuma push monitor URL. Pinged 'up' after a successful send and
# 'down' if a run fails, so a broken digest raises an alert rather than sitting
# silently in the container log. Paste the whole URL Uptime Kuma shows you.
# UPTIME_KUMA_PUSH_URL=https://uptime.example.com/api/push/abc123
