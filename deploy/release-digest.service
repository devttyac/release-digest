[Unit]
Description=Release Digest — monthly games/movies/TV email
Documentation=https://github.com/devttyac/release-digest
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot

# Adjust these paths to your install location.
WorkingDirectory=/srv/release-digest

# --rm so each run leaves nothing behind. The .env is mounted at runtime rather
# than baked into the image, so credentials never live in an image layer.
#
# The trailing `once` is required: the image's default command is the
# long-running scheduler, which never exits. Without `once` this Type=oneshot
# unit would hang until TimeoutStartSec and then be killed as a failure.
ExecStart=/usr/bin/docker run --rm \
    --name release-digest-run \
    --env-file /srv/release-digest/.env \
    -e TZ=Etc/UTC \
    -e ARCHIVE_DIR=/archive \
    -v /srv/release-digest/archive:/archive \
    ghcr.io/devttyac/release-digest:latest once

# A stalled CDN shouldn't leave this hanging until next month's run.
TimeoutStartSec=20min

[Install]
WantedBy=multi-user.target
